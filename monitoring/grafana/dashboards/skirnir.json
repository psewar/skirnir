{
  "uid": "skirnir",
  "title": "Skirnir",
  "tags": ["skirnir", "ollama"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {"type": "row", "title": "Traffic", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "collapsed": false, "panels": []},
    {"id": 1, "type": "timeseries", "title": "Requests per minute by role", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "reqpm", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "sum by (role) (rate(skirnir_requests_total[5m])) * 60", "legendFormat": "{{role}}"}]},
    {"id": 2, "type": "timeseries", "title": "Completion tokens per second by model", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "sum by (model) (rate(skirnir_tokens_total{kind=\"completion\"}[5m]))", "legendFormat": "{{model}}"}]},
    {"id": 3, "type": "timeseries", "title": "Request duration p50 / p95", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 5, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(skirnir_request_duration_seconds_bucket[10m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(skirnir_request_duration_seconds_bucket[10m])))", "legendFormat": "p95"}]},
    {"id": 4, "type": "timeseries", "title": "Errors and queue", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "expr": "sum(rate(skirnir_requests_total{outcome!=\"ok\"}[5m])) * 60", "legendFormat": "errors / min"},
       {"refId": "B", "expr": "sum(skirnir_admission_waiting)", "legendFormat": "waiting"},
       {"refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(skirnir_queue_wait_seconds_bucket[10m])))", "legendFormat": "queue wait p95 (s)"}]},
    {"type": "row", "title": "Nodes", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "id": 101, "collapsed": false, "panels": []},
    {"id": 5, "type": "timeseries", "title": "GPU utilisation %", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "skirnir_node_gpu_util_percent", "legendFormat": "{{node}}"}]},
    {"id": 6, "type": "timeseries", "title": "VRAM free GiB", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 18},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "expr": "skirnir_node_vram_free_gib", "legendFormat": "{{node}} free"},
       {"refId": "B", "expr": "skirnir_node_vram_foreign_gib", "legendFormat": "{{node}} foreign"}]},
    {"id": 7, "type": "timeseries", "title": "GPU power and limit (W)", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "watt", "min": 0, "custom": {"fillOpacity": 5, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "expr": "skirnir_node_gpu_power_w", "legendFormat": "{{node}} power"},
       {"refId": "B", "expr": "skirnir_node_gpu_power_limit_w", "legendFormat": "{{node}} limit"},
       {"refId": "C", "expr": "skirnir_node_gpu_pin16_power_w", "legendFormat": "{{node}} 16-pin"}]},
    {"id": 8, "type": "state-timeline", "title": "Node state", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 26},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"custom": {"fillOpacity": 70, "lineWidth": 0}, "color": {"mode": "fixed"}}, "overrides": [
       {"matcher": {"id": "byRegexp", "options": ".*free.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
       {"matcher": {"id": "byRegexp", "options": ".*busy.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
       {"matcher": {"id": "byRegexp", "options": ".*offline.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]},
     "options": {"showValue": "never", "mergeValues": true, "legend": {"displayMode": "list", "placement": "bottom"}},
     "targets": [{"refId": "A", "expr": "skirnir_node_state == 1", "legendFormat": "{{node}} {{state}}"}]},
    {"id": 9, "type": "state-timeline", "title": "GPU guard state", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 26},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"custom": {"fillOpacity": 70, "lineWidth": 0}, "color": {"mode": "fixed"}}, "overrides": [
       {"matcher": {"id": "byRegexp", "options": ".*normal.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
       {"matcher": {"id": "byRegexp", "options": ".*hochlast.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
       {"matcher": {"id": "byRegexp", "options": ".*gedrosselt.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
       {"matcher": {"id": "byRegexp", "options": ".*(unverfuegbar|aus).*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]},
     "options": {"showValue": "never", "mergeValues": true, "legend": {"displayMode": "list", "placement": "bottom"}},
     "targets": [{"refId": "A", "expr": "skirnir_node_gpu_guard == 1", "legendFormat": "{{node}} {{state}}"}]},
    {"id": 10, "type": "timeseries", "title": "Breaker and inflight", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 26},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "expr": "skirnir_node_inflight", "legendFormat": "{{node}} inflight"},
       {"refId": "B", "expr": "skirnir_node_breaker{state!=\"closed\"} == 1", "legendFormat": "{{node}} breaker {{state}}"}]},
    {"type": "row", "title": "Models, cloud, decisions", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 102, "collapsed": false, "panels": []},
    {"id": 11, "type": "timeseries", "title": "Loaded models (GiB)", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 33},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 30, "lineWidth": 1, "stacking": {"mode": "normal"}}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "skirnir_model_loaded_gib", "legendFormat": "{{node}} {{model}}"}]},
    {"id": 12, "type": "timeseries", "title": "Generation speed tok/s (EWMA)", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 33},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 5, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "skirnir_perf_gen_tps", "legendFormat": "{{model}} @ {{node}}"}]},
    {"id": 13, "type": "stat", "title": "Cloud spend this month (CHF)", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 33},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name", "colorMode": "none"},
     "targets": [{"refId": "A", "expr": "skirnir_cloud_spend_month_chf", "legendFormat": "{{provider}}"}]},
    {"id": 14, "type": "stat", "title": "Requests today", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 37},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "none"},
     "targets": [{"refId": "A", "expr": "skirnir_usage_today_requests", "legendFormat": "today"}]},
    {"id": 15, "type": "timeseries", "title": "Auto role: decisions per minute by engine", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 41},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "sum by (engine) (rate(skirnir_decision_total[5m])) * 60", "legendFormat": "{{engine}}"}]},
    {"id": 16, "type": "timeseries", "title": "Events per minute", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 41},
     "datasource": {"type": "prometheus", "uid": "skirnir-prom"},
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "expr": "sum by (event) (rate(skirnir_events_total[5m])) * 60", "legendFormat": "{{event}}"}]}
  ]
}
