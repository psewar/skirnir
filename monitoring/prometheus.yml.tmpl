# Vorlage; deploy_ct.py ersetzt __ROUTER_HOST__ durch den TLS-Namen des Routers (public_url) und legt sie als prometheus.yml ab.
global:
  scrape_interval: 15s
  evaluation_interval: 30s

scrape_configs:
  - job_name: skirnir
    scheme: https
    metrics_path: /metrics
    scrape_interval: 15s
    basic_auth:
      username: metrics
      password_file: /etc/prometheus/metrics.pass
    tls_config:
      server_name: __ROUTER_HOST__      # Zertifikat lautet auf den oeffentlichen Namen, verbunden wird ueber den Docker-Host
    static_configs:
      - targets: ["host.docker.internal:11435"]
        labels:
          instance: skirnir

  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
