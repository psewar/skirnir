# Template for /etc/skirnir-router-secrets/render-env.conf (folder 0700 root, outside everything the router may write;
# ADR-0073; file 0600). render-env.sh sources it as root and renders /etc/skirnir-router/secrets.env (ADR-0104).
# Without this file nothing is rendered and secrets.env can be maintained by hand.

# Where the values come from: store (default) or file.
SECRET_SOURCE=store

# --- SECRET_SOURCE=store: a secret store with a universal-auth API (role viewer) -----------------------------------------
# Either set the three access variables directly ...
SECRET_STORE_DOMAIN=https://secrets.example.net
SECRET_STORE_CLIENT_ID=00000000-0000-0000-0000-000000000000
SECRET_STORE_CLIENT_SECRET=changeme
# ... or name a file that sets them (sourced with `.`; root, 0600, never under /etc/skirnir-router):
# SECRET_STORE_AUTH_FILE=/etc/skirnir-router-secrets/secret-store-auth.env
PROJECT_ID=00000000-0000-0000-0000-000000000000
ENVIRONMENT=prod

# --- SECRET_SOURCE=file: a root-only file with one KEY=value per line ----------------------------------------------------
# root-owned, 0600 or stricter, in a folder only root may write and outside the router's paths (here: next to this file).
# It is read line by line, never sourced; only the built-in names and EXTRA_SECRET_KEYS are copied, values with a line
# break and names given twice are skipped.
# SECRET_FILE=/etc/skirnir-router-secrets/secrets.source.env

# --- optional for both (ADR-0080) ----------------------------------------------------------------------------------------
# Further secrets for secrets.env, e.g. the key of a further OpenAI-compatible cloud provider (named as api_key_env in
# config.yaml). Capital letters, digits and _ only, ending in _KEY or _TOKEN (secrets.env is the router unit's environment;
# LD_PRELOAD, PATH and the like are refused).
# EXTRA_SECRET_KEYS="EXAMPLE_API_KEY"
