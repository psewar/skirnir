[Unit]
Description=Skirnir - Ollama role router
After=network-online.target skirnir-router-secrets.service
Wants=network-online.target skirnir-router-secrets.service

[Service]
Type=simple
# venv mit --system-site-packages: Debian-Pakete (aiohttp, yaml, cryptography) plus pip-Abhaengigkeiten der optionalen
# Schichten (router/requirements-session.txt); deploy.py legt sie an und prueft sie vor jedem Neustart.
ExecStart=/opt/skirnir-router/venv/bin/python /opt/skirnir-router/router.py /etc/skirnir-router/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/skirnir-router/secrets.env
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/skirnir-router
ReadWritePaths=/etc/skirnir-router
StateDirectory=skirnir-router
LogsDirectory=skirnir-router
PrivateTmp=true

[Install]
WantedBy=multi-user.target
