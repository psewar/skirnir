[Unit]
Description=Skirnir - Ollama role router
After=network-online.target ollama-router-secrets.service
Wants=network-online.target ollama-router-secrets.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ollama-router/router.py /etc/ollama-router/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/ollama-router/secrets.env
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ollama-router
ReadWritePaths=/etc/ollama-router
StateDirectory=ollama-router
LogsDirectory=ollama-router
PrivateTmp=true

[Install]
WantedBy=multi-user.target
