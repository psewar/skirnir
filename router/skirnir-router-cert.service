[Unit]
Description=Reload skirnir-router TLS certificate (triggered by skirnir-router-cert.path)

[Service]
Type=oneshot
# kurz warten, bis der ACME-Client auch den Key geschrieben hat (crt und key werden nacheinander geschrieben)
ExecStartPre=/bin/sleep 5
# ADR-0086: a renewed key must stay readable for the router's group (and nothing more) before the restart
ExecStart=/opt/skirnir-router/router-layout.sh --tls
ExecStart=/usr/bin/systemctl restart skirnir-router.service
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
RestrictSUIDSGID=true
