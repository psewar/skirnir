[Unit]
Description=Reload ollama-router TLS certificate (triggered by ollama-router-cert.path)

[Service]
Type=oneshot
# kurz warten, bis der ACME-Client auch den Key geschrieben hat (crt und key werden nacheinander geschrieben)
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/systemctl restart ollama-router.service
